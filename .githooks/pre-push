#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

READMES=$(find "$ROOT/examples" -name 'README.md' 2>/dev/null)
if [ -z "$READMES" ]; then
    exit 0
fi

if ! command -v npx >/dev/null 2>&1; then
    echo "pre-push: npx not found, skipping embedme verify"
    exit 0
fi

echo "pre-push: verifying embedded docs..."
# shellcheck disable=SC2086
npx -y embedme --verify $READMES
echo "pre-push: docs up to date"
