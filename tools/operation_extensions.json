{
  "$comment": "Per-operation extensions not in upstream notecard-schema. Merged into the OpenAPI spec by schema_to_openapi.py during conversion. Keys are endpoint names (dot-notation), values map HTTP method (lowercase) to extension objects merged into the operation. A special 'path' key applies extensions to the path item (e.g. x-aliases, x-flat-alias).",
  "card.attn": {
    "put": {
      "x-intents": [
        {
          "name": "arm",
          "description": "Arm ATTN pin for interrupt on an event trigger.",
          "fields": ["mode", "files", "seconds", "on"],
          "flags": ["auxgpio", "connected", "env", "files", "location", "motion", "motionchange", "signal", "usb", "wireless"],
          "response": ["set"],
          "supports_cmd": true,
          "mode_prefix": "arm"
        },
        {
          "name": "rearm",
          "description": "Idempotent arm — arms ATTN if not already armed, or resets mode/files/seconds to the values given. Safe to call repeatedly (unlike arm which briefly disarms).",
          "fields": ["mode", "files", "seconds", "on"],
          "flags": ["auxgpio", "connected", "env", "files", "location", "motion", "motionchange", "signal", "usb", "wireless"],
          "response": ["set"],
          "supports_cmd": true,
          "mode_prefix": "rearm"
        },
        {
          "name": "watchdog",
          "description": "Configure ATTN as a watchdog timer.",
          "implicit": {"mode": "watchdog"},
          "fields": ["seconds"],
          "response": [],
          "supports_cmd": true
        },
        {
          "name": "sleep",
          "description": "Instruct host MCU to sleep with optional payload.",
          "implicit": {"mode": "sleep"},
          "fields": ["seconds", "payload"],
          "response": [],
          "supports_cmd": true
        },
        {
          "name": "retrieve",
          "description": "Retrieve stored payload after sleep.",
          "implicit": {"start": true},
          "fields": [],
          "response": ["payload", "time"],
          "supports_cmd": false
        },
        {
          "name": "disarm",
          "description": "Disarm all attention interrupts.",
          "implicit": {"mode": "disarm,-all"},
          "fields": [],
          "response": [],
          "supports_cmd": true
        },
        {
          "name": "off",
          "description": "Disable all ATTN processing. Unlike disarm, this completely stops ATTN monitoring rather than just clearing triggers.",
          "implicit": {"off": true},
          "fields": [],
          "response": [],
          "supports_cmd": true
        },
        {
          "name": "on",
          "description": "Re-enable ATTN processing after it was disabled with off(). Retained across device restarts.",
          "implicit": {"on": true},
          "fields": [],
          "response": [],
          "supports_cmd": true
        },
        {
          "name": "query",
          "description": "Query current ATTN state and configuration.",
          "fields": ["verify"],
          "response": ["set", "off", "files"],
          "safety": "readonly",
          "supports_cmd": false
        }
      ]
    },
    "path": {
      "x-flat-alias": "attn"
    }
  },
