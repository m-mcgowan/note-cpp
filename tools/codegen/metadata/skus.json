{
  "$schema": "https://json-schema.org/draft-07/schema",
  "description": "Notecard SKU table. Source of truth for the SkuType<>/SkuInfo constexpr lookup generated into include/note/sku_info.hpp. One entry per SKU. Fields that can't be confirmed from Blues' public docs are marked \"Unknown\" so the type system degrades safely.",

  "radios_values": ["Cell", "WiFi", "CellWifi", "LoRa", "Skylo"],
